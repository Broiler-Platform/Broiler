<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Broiler.Launcher</RootNamespace>
    <AssemblyName>Broiler.Launcher.Core</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BroilerOfficeDemo)' == 'true'">
    <DefineConstants>$(DefineConstants);BROILER_OFFICE_DEMO</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BroilerOfficeBootstrapDemo)' == 'true'">
    <DefineConstants>$(DefineConstants);BROILER_OFFICE_BOOTSTRAP_DEMO</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateBootstrapDemo" BeforeTargets="CoreCompile" Condition="'$(BroilerOfficeBootstrapDemo)' == 'true'">
    <Error Condition="'$(BroilerOfficeDemo)' != 'true'" Text="Online bootstrap is only available in explicit demo builds." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="ReleaseTrust/office-release-keys.json" LogicalName="Broiler.Launcher.OfficeReleaseKeys.json" />
    <PackageReference Include="Broiler.UI" />
    <PackageReference Include="Broiler.UI.Standard" />
    <PackageReference Include="Broiler.UI.Button.Standard" />
    <PackageReference Include="Broiler.UI.Label.Standard" />
    <PackageReference Include="Broiler.UI.Panel.Standard" />
    <PackageReference Include="Broiler.UI.Menu.Standard" />
    <PackageReference Include="Broiler.UI.Window.Standard" />
    <PackageReference Include="Broiler.UI.Dialog.Standard" />
    <PackageReference Include="Broiler.UI.AboutDialog.Standard" />
    <PackageReference Include="Broiler.UI.Edit.Standard" />
    <PackageReference Include="Broiler.UI.CheckBox.Standard" />
    <PackageReference Include="Broiler.UI.ComboBox.Standard" />
    <PackageReference Include="Broiler.UI.ScrollView.Standard" />
    <PackageReference Include="Broiler.UI.FileDialog.Standard" />
    <PackageReference Include="Broiler.Graphics" />
  </ItemGroup>
</Project>
