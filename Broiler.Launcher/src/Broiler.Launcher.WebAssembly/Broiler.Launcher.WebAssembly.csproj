<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <PublishTrimmed>true</PublishTrimmed>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Broiler.Launcher.Browser/Broiler.Launcher.Browser.csproj" />
    <PackageReference Include="Broiler.Hosting.WebAssembly" GeneratePathProperty="true" />
    <PackageReference Include="Broiler.Hosting.Contracts" />
    <PackageReference Include="Broiler.Graphics.WebAssembly" GeneratePathProperty="true" />
    <PackageReference Include="Broiler.Graphics" />
    <PackageReference Include="Broiler.UI" />
    <PackageReference Include="Broiler.UI.Standard" />
    <PackageReference Include="Broiler.UI.Button.Standard" />
    <PackageReference Include="Broiler.UI.Label.Standard" />
    <PackageReference Include="Broiler.UI.Window.Standard" />
    <StaticWebAssetFingerprintPattern Include="MainJs" Pattern="main.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>
  <Import Project="BrowserPackageAssets.targets" />
</Project>
