<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Supply released versions after publishing W1. Local verification overrides these explicitly. -->
    <BroilerWebHostingVersion Condition="'$(BroilerWebHostingVersion)' == ''">0.1.0-preview.13</BroilerWebHostingVersion>
    <BroilerWebGraphicsVersion Condition="'$(BroilerWebGraphicsVersion)' == ''">0.1.0-preview.17</BroilerWebGraphicsVersion>
    <BroilerUiVersion Condition="'$(BroilerUiVersion)' == ''">0.1.0-preview.26</BroilerUiVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Broiler.Hosting.Contracts" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Hosting.WebAssembly" Version="0.1.0-preview.14" />
    <PackageVersion Include="Broiler.Graphics" Version="0.1.0-preview.18" />
    <PackageVersion Include="Broiler.Graphics.WebAssembly" Version="0.1.0-preview.18" />
    <PackageVersion Include="Broiler.UI" Version="0.1.0-preview.29" />
    <PackageVersion Include="Broiler.UI.Standard" Version="0.1.0-preview.29" />
    <PackageVersion Include="Broiler.UI.Button.Standard" Version="0.1.0-preview.29" />
    <PackageVersion Include="Broiler.UI.Label.Standard" Version="0.1.0-preview.29" />
    <PackageVersion Include="Broiler.UI.Window.Standard" Version="0.1.0-preview.29" />
  </ItemGroup>
</Project>