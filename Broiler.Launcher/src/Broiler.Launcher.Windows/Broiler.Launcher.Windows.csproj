<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Broiler.Launcher.Windows</RootNamespace>
    <AssemblyName>Broiler.Launcher.Windows</AssemblyName>
    <ApplicationIcon>Broiler.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Launcher.Core\Broiler.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Graphics.Windows" />
    <PackageReference Include="Broiler.Hosting.Windows" />
    <PackageReference Include="Broiler.Input" />
    <PackageReference Include="Broiler.Input.Keyboard" />
    <PackageReference Include="Broiler.Input.Mouse" />
  </ItemGroup>
</Project>
