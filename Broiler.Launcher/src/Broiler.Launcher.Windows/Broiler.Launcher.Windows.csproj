<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Broiler.Launcher.Windows</RootNamespace>
    <AssemblyName>Broiler.Launcher.Windows</AssemblyName>
    <ApplicationIcon>Broiler.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows;Office-Windows</Configurations>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Debug-Windows' Or '$(Configuration)' == 'Release-Windows' Or '$(Configuration)' == 'Office-Windows'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BroilerOfficeAllInOne)' == 'true'">
    <AssemblyName>Broiler.Office</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Launcher.Core\Broiler.Launcher.Core.csproj"
                      AdditionalProperties="BroilerOfficeAllInOne=true;BroilerIncludeBrowser=$(BroilerIncludeBrowser)"
                      Condition="'$(BroilerOfficeAllInOne)' == 'true' And '$(Configuration)' != 'Office-Windows'" />
    <ProjectReference Include="..\Broiler.Launcher.Core\Broiler.Launcher.Core.csproj"
                      Condition="'$(BroilerOfficeAllInOne)' != 'true' Or '$(Configuration)' == 'Office-Windows'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Graphics.Windows" />
    <PackageReference Include="Broiler.Hosting.Windows" />
    <PackageReference Include="Broiler.Native.Windows" />
    <PackageReference Include="Broiler.Input" />
    <PackageReference Include="Broiler.Input.Keyboard" />
    <PackageReference Include="Broiler.Input.Mouse" />
  </ItemGroup>

  <ItemGroup Condition="'$(BroilerOfficeAllInOne)' == 'true'">
    <IlcArg Include="--substitution:$(MSBuildThisFileDirectory)..\..\..\Broiler.Mail\src\Broiler.Mail.Windows\NativeAot.Substitutions.xml" Condition="'$(PublishAot)' == 'true'" />
    <Compile Include="..\Broiler.Launcher.Office\*.cs" Link="Office\Shared\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\Broiler.Mail\src\Broiler.Mail.Windows\Preview\*.cs"
             Exclude="..\..\..\Broiler.Mail\src\Broiler.Mail.Windows\Preview\HtmlPreviewWindow.cs"
             Link="Office\MailPreview\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\..\Broiler.Mail\src\Broiler.Mail.Core\Broiler.Mail.Core.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Mail\src\Broiler.Mail.Application\Broiler.Mail.Application.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Mail\src\Broiler.Mail.Infrastructure\Broiler.Mail.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Writer\src\Broiler.Writer\Broiler.Writer.Core.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Cells\src\Broiler.Cells.Core\Broiler.Cells.Core.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Cells\src\Broiler.Cells.Controls\Broiler.Cells.Controls.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Cells\src\Broiler.Cells.UI\Broiler.Cells.UI.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Plate\src\Broiler.Plate\Broiler.Plate.Core.csproj" />
    <ProjectReference Include="..\..\..\Broiler.Browser\src\Broiler.Browser.Core\Broiler.Browser.Core.csproj" Condition="'$(BroilerIncludeBrowser)' == 'true'" />
    <PackageReference Include="Broiler.Documents.Pdf" />
    <PackageReference Include="Broiler.Documents.Pdf.Fonts" />
    <PackageReference Include="Broiler.Documents.Pdf.Images" />
    <PackageReference Include="Broiler.HTML.Core" />
    <PackageReference Include="Broiler.HTML.Image" />
    <PackageReference Include="Broiler.HTML.Image.Compat" />
    <PackageReference Include="Broiler.Media.Image.Managed" />
    <PackageReference Include="Broiler.Net" />
    <PackageReference Include="Broiler.UI.Tooltip.Standard" />
  </ItemGroup>
</Project>
