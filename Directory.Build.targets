<Project>

  <!--
    Standalone Broiler.HTML builds use the Graphics checkout nested inside that submodule.
    Root builds instead use the canonical top-level Graphics checkout, which since the
    component directories became submodules means the src/ layout Broiler.Graphics publishes
    today. Delete this block once Broiler.HTML follows Broiler.Graphics into src/ and the
    gitlink here is bumped past that commit.
  -->
  <ItemGroup Condition="'$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)Broiler.HTML\Source\Broiler.HTML.Graphics.Win32.Demo\Broiler.HTML.Graphics.Win32.Demo.csproj'">
    <ProjectReference Remove="..\..\Broiler.Graphics\Broiler.Graphics.Windows\Broiler.Graphics.Direct2D.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Broiler.Graphics\src\Broiler.Graphics.Windows\Broiler.Graphics.Direct2D.csproj" />
  </ItemGroup>

  <!--
    Broiler.HTML reaches the top-level Broiler.Media checkout through the pre-src/ layout
    ("Broiler.Media\Broiler.Media.Image.Managed\"). That layout only ever existed while this
    repository vendored Broiler.Media as a plain directory; the standalone
    Broiler-Platform/Broiler.Media repository publishes its projects under src/, so the
    reference as written no longer resolves.

    Delete this block once Broiler.HTML follows Broiler.Media into src/ and the gitlink here
    is bumped past that commit.
  -->
  <ItemGroup Condition="'$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)Broiler.HTML\Source\Broiler.HTML.Image\Broiler.HTML.Image.csproj'">
    <ProjectReference Remove="..\..\..\Broiler.Media\Broiler.Media.Image.Managed\Broiler.Media.Image.Managed.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Broiler.Media\src\Broiler.Media.Image.Managed\Broiler.Media.Image.Managed.csproj" />
  </ItemGroup>

  <!--
    Every component submodule carries nested checkouts ("mirrors") of the components it depends
    on so that it still builds standalone, and its project references are relative, so in the
    aggregate workspace they resolve into those mirrors rather than the canonical top-level
    checkout. One root build therefore compiled the same component several times from several
    source trees — nine copies of Broiler.Media, eight of Broiler.Graphics, 53 duplicated
    assemblies across the root solutions — emitting assemblies that share a name, one of which
    wins the copy into any output directory that sees both. Broiler.Media ADR 0001 forbids it:
    during aggregate development every local project reference must point at the single root
    checkout.

    Directory.Build.props already collapses two kernels this way via
    $(BroilerDomPath)/$(BroilerGraphicsPath), but that only works for references written as
    $(BroilerXPath), and the component submodules never adopted it — theirs are literal relative
    paths. The generated file below covers those from the root, needing no submodule change.

    It is regenerated by scripts/generate-aggregate-reference-redirects.py, which redirects a
    mirror ONLY when its pinned commit matches the canonical checkout's, so a redirect can never
    change which source compiles. Mirrors on a different pin, and mirrors of components with no
    top-level checkout, are left alone and listed in that file with the reason.

    This is not a migration workaround with a deletion trigger, unlike the two Broiler.HTML
    blocks above: a component that must build standalone will always carry a checkout of what it
    depends on, so the aggregate workspace will always have mirrors to redirect.
  -->
  <PropertyGroup>
    <!--
      The generated file lives in eng\, so it cannot anchor on its own
      $(MSBuildThisFileDirectory) without a '..' segment. MSBuild compares condition strings
      literally, so a '..' in either operand would never match $(MSBuildProjectFullPath) and
      every redirect would silently do nothing. Hand it this already-normalised root instead.
    -->
    <BroilerWorkspaceRoot>$(MSBuildThisFileDirectory)</BroilerWorkspaceRoot>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)eng\aggregate-workspace-references.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)eng\aggregate-workspace-references.targets')" />

  <!--
    Broiler.Media.Video.Windows arrives with the borrowed-HWND contract patches under patches\
    (Broiler.Media ADR 0006), which Broiler.Graphics.Direct2D references once applied. The
    generator cannot emit this one yet — the project does not exist in either checkout — but
    redirecting it is what lets the two submodule patches land in either order: without it,
    applying the Graphics patch before bumping that component's own Broiler.Media gitlink leaves
    Direct2D pointing at a project its mirror does not have, and the build fails outright. The
    Exists guard keeps this inert until the Media patch lands. Delete once both have landed and
    the generator picks the reference up on its own.
  -->
  <ItemGroup Condition="'$(MSBuildProjectFullPath)' == '$(MSBuildThisFileDirectory)Broiler.Graphics\src\Broiler.Graphics.Windows\Broiler.Graphics.Direct2D.csproj'">
    <ProjectReference Remove="..\..\Broiler.Media\src\Broiler.Media.Video.Windows\Broiler.Media.Video.Windows.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Broiler.Media\src\Broiler.Media.Video.Windows\Broiler.Media.Video.Windows.csproj"
                      Condition="Exists('$(MSBuildThisFileDirectory)Broiler.Media\src\Broiler.Media.Video.Windows\Broiler.Media.Video.Windows.csproj')" />
  </ItemGroup>

</Project>
