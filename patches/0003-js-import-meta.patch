 .../ImportMetaTests.cs                        | 112 ++++++++++++++++++
 .../Broiler.JavaScript.Modules/JSModule.cs    |  48 ++++++++
 .../JSModuleContext.cs                        |  34 ++++++
 4 files changed, 230 insertions(+)
