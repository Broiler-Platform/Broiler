+    /// </remarks>
+    private bool FlipX => _scaleX < 0f;
+
+    /// <summary>Whether the current mapping mirrors the Y axis (a negative <see cref="_scaleY"/>).</summary>
+    private bool FlipY => _scaleY < 0f;
