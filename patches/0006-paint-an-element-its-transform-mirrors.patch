@@ -702,6 +755,9 @@ internal sealed class BCanvas(BBitmap bitmap) : IDisposable
         if (!NarrowToClip(ref minX, ref minY, ref maxX, ref maxY))
             return;
 
+        bool flipX = FlipX;
