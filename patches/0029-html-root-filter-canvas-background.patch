-                    NumberStyles.Float,
-                    CultureInfo.InvariantCulture, out var pct))
-                    amount = pct / 100f;
-            }
-            else if (float.TryParse(valStr,
-                NumberStyles.Float,
-                CultureInfo.InvariantCulture, out var val))
-            {
-                amount = val;
-            }
-            amount = Math.Clamp(amount, 0f, 1f);
