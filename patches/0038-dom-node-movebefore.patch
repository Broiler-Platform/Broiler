 Broiler.Dom.Tests/DomMoveBeforeTests.cs | 266 ++++++++++++++++++++++++
 Broiler.Dom/DomNode.cs                  | 106 ++++++++++
 2 files changed, 372 insertions(+)
 create mode 100644 Broiler.Dom.Tests/DomMoveBeforeTests.cs

diff --git a/Broiler.Dom.Tests/DomMoveBeforeTests.cs b/Broiler.Dom.Tests/DomMoveBeforeTests.cs
