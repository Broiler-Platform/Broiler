From 2779c474e1d75c7da459619a08eaec1818646e10 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 30 Jul 2026 15:55:22 +0000
Subject: [PATCH] parse: keep a <template>'s stylesheets out of the document
 cascade
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

HTML §4.12.3 holds a <template>'s children in a separate document fragment as
its template contents: inert until stamped out. They already produced no boxes,
but CascadeParseStyles walked the whole box tree collecting <style> elements and
did not stop at a template — so a component that keeps its styles in a template,
which is the ordinary way to write one, leaked them into the host document.

WPT issue #1491 problem 29,
shadow-dom/focus-navigation/delegatesFocus-highlight-sibling.html, is the worst
case: its template carries `:host { background-color: #aaa }` and
`:host(:focus) { background-color: #ccc }`. Leaked into the document those
matched the page itself, so Broiler painted 99% of the canvas #ccc against a
Chromium reference that is 98% white — a 0.0% match. With the leak closed the
same test renders 98.2% matching.

The remaining 1.8% is a different gap and is not addressed here: a shadow root
attached from a custom element's connectedCallback does not render its content,
so the test's four <x-menu> hosts and their <li> items are missing. A shadow
root populated by innerHTML on a plain element does render, which is what
isolates the custom-element path as the culprit.
---
 .../Broiler.HTML.Orchestration/Parse/DomParser.cs   | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/Source/Broiler.HTML.Orchestration/Parse/DomParser.cs b/Source/Broiler.HTML.Orchestration/Parse/DomParser.cs
index f314f81..0b2b5ff 100644
--- a/Source/Broiler.HTML.Orchestration/Parse/DomParser.cs
+++ b/Source/Broiler.HTML.Orchestration/Parse/DomParser.cs
@@ -114,6 +114,19 @@ internal sealed class DomParser
 
     private void CascadeParseStyles(CssBox box, ref HtmlStyleSet styleSet)
     {
+        // HTML §4.12.3: a <template>'s children are its *template contents*, held in a separate
+        // document fragment. They are inert — not rendered, and their <style>/<link> do not style
+        // the host document; a template is a stamp, and nothing on it applies until it is stamped
+        // out. The contents already produce no boxes, but this walk collected their stylesheets
+        // anyway, so a shadow-DOM component that keeps its styles in a <template> (the ordinary way
+        // to write one) leaked them into the page. That is WPT issue #1491 problem 29:
+        // delegatesFocus-highlight-sibling puts `:host { background-color: #aaa }` and
+        // `:host(:focus) { background-color: #ccc }` in a template, and Broiler painted 99% of the
+        // canvas #ccc against a reference that is 98% white.
+        if (box.HtmlTag != null &&
+            box.HtmlTag.Name.Equals("template", StringComparison.CurrentCultureIgnoreCase))
+            return;
+
         if (box.HtmlTag != null)
         {
             // CSSOM §2.3 / HTML §4.2.6: a disabled stylesheet does not apply.
-- 
