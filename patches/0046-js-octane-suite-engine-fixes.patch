From 897fadbe2bfb4889ed5315641af528d75fb98cb3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 1 Aug 2026 05:35:31 +0000
Subject: [PATCH] Fix five engine defects behind the failing Octane 2.0 suites
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Octane's Crypto, PdfJS, CodeLoad, zlib and Typescript suites all failed under
the BroilerJS shell. Each traced to a distinct engine defect, reproducible in
a few lines and independent of the benchmark:

* Non-strict `eval`: a `var` initializer inside a function the eval'd code
  declares was routed to the eval var-environment binding instead of the
  function's own hoisted local, so the store never reached the binding reads
  resolve to — and, because that binding is indexed off the global object, the
  value leaked out as a global. `eval("(function(){ var x = 42; return x; })()")`
  returned 0 and defined a global `x`. Every other direct-eval root-hoisting
  site already guarded on `Function == null`; VisitVariableDeclaration did not.
  (CodeLoad: the eval'd jQuery source's `windowmock` never initialized.)

* `obj == null` / `obj == undefined` ran ToPrimitive on the object. Per
  IsLooselyEqual (7.2.14) an Object compared with null or undefined is `false`
  at step 11 with no coercion; only String/Number/BigInt/Symbol reach the
  ToPrimitive steps. The coercion made the ubiquitous null-check idiom call
  user code. (Crypto: `if (r == null)` on a BigInteger reached
  BigInteger.prototype.toString -> toRadix -> divRemTo -> the same test,
  recursing until the stack was exhausted and the process aborted.)

* `undefined + x` concatenated as a string instead of adding numerically.
  ToPrimitive leaves `undefined` a non-String, so §13.15 adds it via ToNumeric
  (NaN); CanBeNumber deliberately excludes undefined for the relational
  operators, so `+` now widens the test itself. `undefined + undefined` was
  "undefinedundefined". (PdfJS: `this.end = (start + length) || bytes.length`
  with both arguments omitted stored that truthy string, so every stream
  reported a NaN length and parsing rejected the document as malformed.)

* The last expression of a C-style `for` head's comma list was parsed and then
  discarded: it stayed in `node` while the AstSequenceExpression built from the
  earlier operands replaced it. `for (i = 0, len = a.length; …)` never assigned
  `len`. (Typescript: Binder.resolveBases reused the previous loop's bound and
  walked `type.implementsTypeLinks` past its end.)

* Added the `read` shell builtin next to `print`. Emscripten's shell preamble
  references it unconditionally (`Module.read = read`) the way d8 and
  SpiderMonkey provide it, so its absence was a ReferenceError before the
  benchmark ran a line. (zlib.)

`read(path)` returns the file as a string, `read(path, "binary")` as a
Uint8Array, and a missing or unreadable file raises a JavaScript Error.

Full Broiler.JS test suite green (13 projects, 7281 tests).

Claude-Session: https://claude.ai/code/session_014rA1kFfRgAYZjjVC7ZuPWD

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../FastCompiler.VisitVariableDeclaration.cs  | 12 +++++-
 .../FastParser.ForStatement.cs                | 11 ++++++
 .../JSObject.DynamicDispatch.cs               | 10 +++++
 .../JSPrimitiveObject.cs                      |  6 +++
 .../Broiler.JavaScript.Runtime/JSValue.cs     | 21 +++++++++-
 Broiler.JS/Broiler.JavaScript/Program.cs      | 39 +++++++++++++++++++
 6 files changed, 96 insertions(+), 3 deletions(-)

diff --git a/Broiler.JS/Broiler.JavaScript.Compiler/Statements/FastCompiler.VisitVariableDeclaration.cs b/Broiler.JS/Broiler.JavaScript.Compiler/Statements/FastCompiler.VisitVariableDeclaration.cs
index e3b2ec30..7a5b5b66 100644
--- a/Broiler.JS/Broiler.JavaScript.Compiler/Statements/FastCompiler.VisitVariableDeclaration.cs
+++ b/Broiler.JS/Broiler.JavaScript.Compiler/Statements/FastCompiler.VisitVariableDeclaration.cs
@@ -30,7 +30,17 @@ partial class FastCompiler
             {
                 case FastNodeType.Identifier:
                     var id = d.Identifier as AstIdentifier;
-                    var v = isDirectEvalCompilation && !IsStrictMode && !newScope && !usesDirectEvalLocalVarEnvironment
+                    // Only the eval program's OWN top-level `var` belongs to the eval
+                    // var environment. A `var` inside a function the eval code declares
+                    // is an ordinary function local, and routing it to the eval root
+                    // binding broke it twice over: the hoisted local (VisitBlock) is what
+                    // reads resolve to, so the initializer store went to a *different*
+                    // binding — leaving `eval("(function(){ var x = 42; return x; })()")`
+                    // 0 (numeric local) or undefined — and that binding is indexed off the
+                    // global object, so the value leaked out as a global `x`. Every other
+                    // direct-eval root-hoisting site guards on the same `Function == null`
+                    // (VisitBlock, VisitSwitchStatement, VisitProgram); this one did not.
+                    var v = isDirectEvalCompilation && top.Function == null && !IsStrictMode && !newScope && !usesDirectEvalLocalVarEnvironment
                         ? GetOrCreateDirectEvalRootVariable(id.Name)
                         : top.CreateVariable(id.Name, JSVariableBuilder.New(id.Name.Value), newScope);
                     if (d.Init == null)
diff --git a/Broiler.JS/Broiler.JavaScript.Parser/FastParser.ForStatement.cs b/Broiler.JS/Broiler.JavaScript.Parser/FastParser.ForStatement.cs
index abfc9cc1..0e3c0ef7 100644
--- a/Broiler.JS/Broiler.JavaScript.Parser/FastParser.ForStatement.cs
+++ b/Broiler.JS/Broiler.JavaScript.Parser/FastParser.ForStatement.cs
@@ -575,7 +575,18 @@ partial class FastParser
                     break;
 
                 if (stream.CheckAndConsume(TokenTypes.SemiColon))
+                {
+                    // The expression before the head's `;` closes a comma list, so it
+                    // belongs in `list` like every earlier one. Leaving it only in `node`
+                    // dropped it: the AstSequenceExpression built below REPLACES `node`,
+                    // so `for (i = 0, len = a.length; …)` compiled to just `i = 0` and
+                    // never assigned `len` (Octane's Typescript suite walks a stale index
+                    // and dies on `type.implementsTypeLinks[i].ast`). Only when a comma was
+                    // actually seen — a lone head expression stays an ordinary expression.
+                    if (list.Any())
+                        list.Add(node);
                     break;
+                }
 
                 if (stream.CheckAndConsume(TokenTypes.Comma))
                 {
diff --git a/Broiler.JS/Broiler.JavaScript.Runtime/JSObject.DynamicDispatch.cs b/Broiler.JS/Broiler.JavaScript.Runtime/JSObject.DynamicDispatch.cs
index 166d53fb..96125f05 100644
--- a/Broiler.JS/Broiler.JavaScript.Runtime/JSObject.DynamicDispatch.cs
+++ b/Broiler.JS/Broiler.JavaScript.Runtime/JSObject.DynamicDispatch.cs
@@ -77,6 +77,16 @@ public partial class JSObject
         if (value.IsObject)
             return false;
 
+        // IsLooselyEqual (7.2.14) coerces the object side ONLY against a String,
+        // Number, BigInt or Symbol (steps 9-10). An Object compared with null or
+        // undefined falls through to step 11 — `false`, with no ToPrimitive at all.
+        // Coercing here made the ubiquitous `x == null` null-check call user code:
+        // Octane's Crypto does `if (r == null)` on a BigInteger, whose ToPrimitive
+        // reaches BigInteger.prototype.toString → toRadix → divRemTo → back to the
+        // same test, recursing until the stack was exhausted.
+        if (value.IsNullOrUndefined)
+            return false;
+
         return ToPrimitiveDefault().Equals(value);
     }
 
diff --git a/Broiler.JS/Broiler.JavaScript.Runtime/JSPrimitiveObject.cs b/Broiler.JS/Broiler.JavaScript.Runtime/JSPrimitiveObject.cs
index e9774cd7..403e51c7 100644
--- a/Broiler.JS/Broiler.JavaScript.Runtime/JSPrimitiveObject.cs
+++ b/Broiler.JS/Broiler.JavaScript.Runtime/JSPrimitiveObject.cs
@@ -325,6 +325,12 @@ public class JSPrimitiveObject : JSObject
         if (value is JSPrimitiveObject)
             return false;
 
+        // Same step-11 rule as JSObject.Equals: a wrapper compared with null or
+        // undefined is `false` outright, so the null-check idiom `x == null` must
+        // not run this object's valueOf/toString overrides.
+        if (value.IsNullOrUndefined)
+            return false;
+
         return CoerceOwnOverrides(preferString: false).Equals(value);
     }
 
diff --git a/Broiler.JS/Broiler.JavaScript.Runtime/JSValue.cs b/Broiler.JS/Broiler.JavaScript.Runtime/JSValue.cs
index 78610c07..f41653c7 100644
--- a/Broiler.JS/Broiler.JavaScript.Runtime/JSValue.cs
+++ b/Broiler.JS/Broiler.JavaScript.Runtime/JSValue.cs
@@ -587,6 +587,23 @@ public abstract partial class JSValue : IDynamicMetaObjectProvider, IPropertyAcc
         return !ReferenceEquals(self, this) ? self.Modulo(value) : CreateNumber(DoubleValue % value.DoubleValue);
     }
 
+    /// <summary>
+    /// Whether <paramref name="value"/> takes the numeric branch of <c>+</c>.
+    /// </summary>
+    /// <remarks>
+    /// §13.15 ApplyStringOrNumericBinaryOperator concatenates only when one side is a String
+    /// after ToPrimitive; every other primitive adds via ToNumeric. <c>undefined</c> is one of
+    /// those — ToNumber(undefined) is NaN — but <see cref="CanBeNumber"/> excludes it (the
+    /// relational operators rely on that), so <c>+</c> widens the test here instead. Without
+    /// this, <c>undefined + undefined</c> concatenated to <c>"undefinedundefined"</c>: Octane's
+    /// PdfJS computes <c>this.end = (start + length) || this.bytes.length</c> with both
+    /// arguments omitted, and that truthy string made every stream report a NaN length.
+    /// Symbol and BigInt stay out: they must reach the TypeError paths below.
+    /// </remarks>
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    private static bool AddsNumerically(JSValue value) => value.CanBeNumber || value.IsUndefined;
+
+    /// <summary>
     /// Speed improvements for string contact operations
     /// </summary>
     /// <param name="value"></param>
@@ -599,7 +616,7 @@ public abstract partial class JSValue : IDynamicMetaObjectProvider, IPropertyAcc
         if (!ReferenceEquals(self, this))
             return self.AddValue(value);
 
-        if (self.CanBeNumber && value.CanBeNumber)
+        if (AddsNumerically(self) && AddsNumerically(value))
             return CreateNumber(self.DoubleValue + value.DoubleValue);
 
         // §13.15 ApplyStringOrNumericBinaryOperator for `+`: once neither operand (after
@@ -629,7 +646,7 @@ public abstract partial class JSValue : IDynamicMetaObjectProvider, IPropertyAcc
         if (!ReferenceEquals(self, this))
             return self.AddValue(value);
 
-        if (self.CanBeNumber)
+        if (AddsNumerically(self))
             return CreateNumber(self.DoubleValue + value);
 
         return CreateString(self.StringValue + NumberToECMAString(value));
diff --git a/Broiler.JS/Broiler.JavaScript/Program.cs b/Broiler.JS/Broiler.JavaScript/Program.cs
index 82be4ca9..49748bf6 100644
--- a/Broiler.JS/Broiler.JavaScript/Program.cs
+++ b/Broiler.JS/Broiler.JavaScript/Program.cs
@@ -122,6 +122,45 @@ namespace BroilerJS
                 },
                 "print",
                 length: 1);
+
+            // `read(path)` returns the file's contents as a string; `read(path, "binary")`
+            // returns them as a Uint8Array. The companion to `print` in both d8 and
+            // SpiderMonkey's `js`, and referenced unconditionally by Emscripten's shell
+            // preamble — `Module.read = read` — which is how Octane's zlib benchmark loads
+            // under a JS shell. Without the binding that bare reference was a ReferenceError
+            // before the benchmark ran a single line, even though it never reads a file
+            // (its corpus is embedded in zlib-data.js).
+            context[Broiler.JavaScript.Storage.KeyStrings.GetOrCreate("read")] = JSValue.CreateFunction(
+                (in Arguments a) =>
+                {
+                    var (pathValue, modeValue) = a.Get2();
+                    if (pathValue.IsUndefined)
+                        throw Broiler.JavaScript.Engine.Core.JSEngine.NewTypeError("read requires a file path");
+
+                    var path = pathValue.ToString();
+                    var binary = !modeValue.IsUndefined
+                        && string.Equals(modeValue.ToString(), "binary", StringComparison.Ordinal);
+
+                    try
+                    {
+                        if (!binary)
+                            return new Broiler.JavaScript.BuiltIns.String.JSString(File.ReadAllText(path));
+
+                        var buffer = new Broiler.JavaScript.BuiltIns.Array.Typed.JSArrayBuffer(File.ReadAllBytes(path));
+                        var uint8Array = context[Broiler.JavaScript.Storage.KeyStrings.GetOrCreate("Uint8Array")];
+                        return uint8Array.CreateInstance(new Arguments(JSUndefined.Value, buffer));
+                    }
+                    catch (IOException ex)
+                    {
+                        throw Broiler.JavaScript.Engine.Core.JSEngine.NewError($"Cannot read file {path}: {ex.Message}");
+                    }
+                    catch (UnauthorizedAccessException ex)
+                    {
+                        throw Broiler.JavaScript.Engine.Core.JSEngine.NewError($"Cannot read file {path}: {ex.Message}");
+                    }
+                },
+                "read",
+                length: 1);
         }
     }
 
