                 return ref Empty;
 
             // extend...
-            roots = nodes.Allocate(4);
+            roots = AllocateNodeBlock();
             nodes[roots, 0].State = NodeState.Filled;
         }
 
@@ -317,7 +354,7 @@ public struct SAUint32Map<T>
                 node.State |= NodeState.Filled;
                 if (node.Children.IsEmpty)
                 {
-                    var c = nodes.Allocate(4);
