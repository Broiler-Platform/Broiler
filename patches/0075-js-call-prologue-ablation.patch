+            ("native-call-2-args",
+                "function hot(n) { var s = 0; for (var i = 0; i < n; i++) { s = s + Math.max(i, 0); } return s; }"),
         };
 
         var rows = new List<object>();
@@ -201,11 +226,19 @@ internal static class SpecializingTierMetrics
