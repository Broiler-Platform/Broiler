diff --git a/Broiler.JS/Broiler.JavaScript.Compiler.Tests/MixedNumericComparisonTests.cs b/Broiler.JS/Broiler.JavaScript.Compiler.Tests/MixedNumericComparisonTests.cs
new file mode 100644
