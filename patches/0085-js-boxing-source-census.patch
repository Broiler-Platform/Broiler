+        if (ReferenceEquals(self, this) && ArithmeticOperandDiagnostics.Enabled)
+            ArithmeticOperandDiagnostics.RecordUnaryNegate();
         return !ReferenceEquals(self, this) ? self.BitwiseNot() : CreateNumber(~IntValue);
