From 9e515a4d04ce40d01b493f508661711cfedb92c0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 5 Aug 2026 09:58:16 +0000
Subject: [PATCH] Require the element to match S in :nth-child(An+B of S)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The element's position was looked up in the *filtered* sibling list without
checking that the lookup succeeded. An element that does not match S gets
index -1, and the count-from-the-end branch then computed
`siblings.Count - (-1)` — a positive position the An+B test happily accepts.

So `:nth-last-child(odd of webkit, fast)` matched every non-matching element
whose filtered sibling count is even, <html> among them: its lime background
propagated to the canvas and painted the whole page.

Guard the lookup and return false when the element is absent from the filtered
list, which is what the spec's 'matches S' requirement amounts to. The forward
branch already returned false for the same case via its `position > 0` check,
so only the from-the-end direction changes behaviour.

Fixes the WPT reftest css/selectors/nth-last-child-of-tagname (0.1% -> 98.3%
pixel match against the Chromium reference; the residual is Broiler's text
antialiasing, identical to the delta the test's own reference file shows
against its golden).
---
 .../CssSelectorMatcherTests.cs                | 60 +++++++++++++++++++
 Broiler.CSS.Dom/CssSelectorMatcher.cs         | 12 ++--
 2 files changed, 68 insertions(+), 4 deletions(-)

diff --git a/Broiler.CSS.Dom.Tests/CssSelectorMatcherTests.cs b/Broiler.CSS.Dom.Tests/CssSelectorMatcherTests.cs
index a14cce8..18c5012 100644
--- a/Broiler.CSS.Dom.Tests/CssSelectorMatcherTests.cs
+++ b/Broiler.CSS.Dom.Tests/CssSelectorMatcherTests.cs
@@ -141,6 +141,66 @@ public sealed class CssSelectorMatcherTests
         Assert.True(matcher.Matches(target, "#target:has(:is(.item + .item + .item))"));
     }
 
+    [Fact]
+    public void Nth_Child_Of_Selector_Requires_The_Element_To_Match_The_Filter()
+    {
+        // Regression for the WPT test css/selectors/nth-last-child-of-tagname.html.
+        // `:nth-child(An+B of S)` only matches elements that themselves match S. The
+        // element's position was looked up in the *filtered* sibling list without
+        // checking that the lookup succeeded, so a non-matching element got index -1;
+        // the from-the-end branch then computed `count - (-1)` = count + 1, a positive
+        // position that could satisfy the An+B test. With `odd` that made every
+        // non-matching element with an even filtered-sibling count match — including
+        // <html>, whose lime background propagated to the canvas and painted the whole
+        // page (0.1% pixel match against the reference).
+        var document = new DomDocument();
+        var html = document.CreateElement("html");
+        document.AppendChild(html);
+        var body = document.CreateElement("body");
+        html.AppendChild(body);
+
+        DomElement Append(string name)
+        {
+            var element = document.CreateElement(name);
+            body.AppendChild(element);
+            return element;
+        }
+
+        // The reftest's body, in order: p p webkit p webkit webkit p p fast p p.
+        var intro = Append("p");
+        Append("p");
+        var firstWebkit = Append("webkit");
+        Append("p");
+        var greenWebkit = Append("webkit");
+        var lastWebkit = Append("webkit");
+        Append("p");
+        Append("p");
+        var greenFast = Append("fast");
+        Append("p");
+        var lastParagraph = Append("p");
+
+        var matcher = new CssSelectorMatcher();
+        const string Selector = ":nth-last-child(odd of webkit, fast)";
+
+        // Only the 1st and 3rd elements counting back through {webkit, fast} match.
+        Assert.True(matcher.Matches(greenFast, Selector));
+        Assert.True(matcher.Matches(greenWebkit, Selector));
+        Assert.False(matcher.Matches(lastWebkit, Selector));
+        Assert.False(matcher.Matches(firstWebkit, Selector));
+
+        // Elements outside the `of` selector list never match, at any depth.
+        Assert.False(matcher.Matches(html, Selector));
+        Assert.False(matcher.Matches(body, Selector));
+        Assert.False(matcher.Matches(intro, Selector));
+        Assert.False(matcher.Matches(lastParagraph, Selector));
+
+        // The forward-counting form keeps the same rule.
+        Assert.True(matcher.Matches(firstWebkit, ":nth-child(1 of webkit, fast)"));
+        Assert.True(matcher.Matches(greenWebkit, ":nth-child(2 of webkit, fast)"));
+        Assert.False(matcher.Matches(html, ":nth-child(1 of webkit, fast)"));
+        Assert.False(matcher.Matches(intro, ":nth-child(1 of webkit, fast)"));
+    }
+
     [Fact]
     public void Specificity_Is_Owned_By_The_Css_Kernel()
     {
diff --git a/Broiler.CSS.Dom/CssSelectorMatcher.cs b/Broiler.CSS.Dom/CssSelectorMatcher.cs
index ab966d9..4dba5fc 100644
--- a/Broiler.CSS.Dom/CssSelectorMatcher.cs
+++ b/Broiler.CSS.Dom/CssSelectorMatcher.cs
@@ -274,10 +274,14 @@ public sealed partial class CssSelectorMatcher(ICssSelectorStateProvider? stateP
             : ElementSiblings(element);
         if (filter is not null)
             siblings = [.. siblings.Where(candidate => MatchesAny(candidate, filter, null))];
-        var position = fromEnd
-            ? siblings.Count - siblings.FindIndex(candidate => ReferenceEquals(candidate, element))
-            : siblings.FindIndex(candidate => ReferenceEquals(candidate, element)) + 1;
-        return position > 0 && EvaluateNth(position, nth);
+        // `:nth-child(An+B of S)` only matches elements that themselves match S, so an
+        // element missing from the filtered list never matches. Guarding the lookup is
+        // what enforces that: `siblings.Count - (-1)` is a positive position that the
+        // An+B test would otherwise happily accept.
+        var index = siblings.FindIndex(candidate => ReferenceEquals(candidate, element));
+        if (index < 0)
+            return false;
+        return EvaluateNth(fromEnd ? siblings.Count - index : index + 1, nth);
     }
 
     private static bool MatchesAttribute(DomElement element, AttributeFilter filter)
