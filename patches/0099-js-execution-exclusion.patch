+            realmScope = JSEngine.EnterContext(context);
+            executionScope = context.microtasks.EnterExecution();
+        }
+
+        public void Dispose()
+        {
+            if (disposed)
+                return;
+
+            disposed = true;
+            executionScope.Dispose();
+            realmScope.Dispose();
+        }
+    }
