+            for (var i = 0; i < 40; i++)
+                context.Eval("globalThis.n = globalThis.n + 1;" + Busy);
+        });
+
+        var (peak, overlaps) = JSContext.ExecutionConcurrency;
+        Assert.Equal(0, overlaps);
+        Assert.Equal(1, peak);
