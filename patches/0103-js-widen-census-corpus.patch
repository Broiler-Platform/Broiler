+                    propertyReads = totals.DescribeReads(),
+                    calls = totals.DescribeCalls(),
+                },
+            },
+            new JsonSerializerOptions { WriteIndented = true });
+
+        if (partial)
+            File.WriteAllText(PartialPath, json);
+        else
+            Console.WriteLine(json);
+    }
