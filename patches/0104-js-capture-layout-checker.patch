+    }
+
+    public static void Reset()
+    {
+        Interlocked.Exchange(ref sites, 0);
+        Interlocked.Exchange(ref exact, 0);
+        Interlocked.Exchange(ref over, 0);
+        Interlocked.Exchange(ref missed, 0);
