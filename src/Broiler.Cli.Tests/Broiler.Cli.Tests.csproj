<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Broiler.Cli.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Compatibility coverage intentionally exercises the one-release obsolete CSS facade. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <!--
    Mirrors the probe in Broiler.Cli.csproj: the unhandled-rejection coverage can only pass once the
    Broiler.JS patch adding JSPromiseRejectionTracker is applied, so without it the file is not
    compiled rather than failing against an engine that cannot report them.
  -->
  <PropertyGroup>
    <BroilerJsRejectionTracking Condition="Exists('$(MSBuildThisFileDirectory)..\..\Broiler.JS\Broiler.JS\Broiler.JavaScript.BuiltIns\Promise\JSPromiseRejectionTracker.cs')">true</BroilerJsRejectionTracking>
    <DefineConstants Condition="'$(BroilerJsRejectionTracking)' == 'true'">$(DefineConstants);BROILER_JS_REJECTION_TRACKING</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(BroilerJsRejectionTracking)' != 'true'">
    <Compile Remove="UnhandledPromiseRejectionTests.cs" />
  </ItemGroup>

  <!--
    Mirrors the narrower probe in Broiler.HtmlBridge.Dom.csproj: the rejectionhandled coverage needs
    the engine to say which promise was reported, so without the notification API the file is not
    compiled rather than failing against an engine that cannot fire the event.
  -->
  <PropertyGroup>
    <BroilerJsRejectionPromiseIdentity Condition="Exists('$(MSBuildThisFileDirectory)..\..\Broiler.JS\Broiler.JS\Broiler.JavaScript.BuiltIns\Promise\JSPromiseRejectionNotification.cs')">true</BroilerJsRejectionPromiseIdentity>
    <DefineConstants Condition="'$(BroilerJsRejectionPromiseIdentity)' == 'true'">$(DefineConstants);BROILER_JS_REJECTION_PROMISE_IDENTITY</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(BroilerJsRejectionPromiseIdentity)' != 'true'">
    <Compile Remove="RejectionHandledEventTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.DOM\Broiler.Dom.Html\Broiler.Dom.Html.csproj" />
    <ProjectReference Include="..\..\Broiler.DOM\Broiler.Dom\Broiler.Dom.csproj" />
    <ProjectReference Include="..\..\Broiler.Documents\Broiler.Documents.Docx\Broiler.Documents.Docx.csproj" />
    <ProjectReference Include="..\..\Broiler.Documents\Broiler.Documents.Model\Broiler.Documents.Model.csproj" />
    <ProjectReference Include="..\Broiler.Cli\Broiler.Cli.csproj" />
    <ProjectReference Include="..\..\Broiler.HTML\Source\Broiler.HTML.Image.Compat\Broiler.HTML.Image.Compat.csproj" />
    <ProjectReference Include="..\..\Broiler.HTML\Source\Broiler.HTML.Orchestration\Broiler.HTML.Orchestration.csproj" />
    <ProjectReference Include="..\..\Broiler.HTML\Source\Broiler.HTML.Headless\Broiler.HTML.Headless.csproj" />
    <ProjectReference Include="..\Broiler.HtmlBridge.Scripting\Broiler.HtmlBridge.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.Graphics\Broiler.Graphics\Broiler.Graphics.csproj" />
  </ItemGroup>
</Project>
