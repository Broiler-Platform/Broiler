<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    An editable, worker-visible configuration input. The build worker must add
    this file to the granted snapshot and to the build-input hash manifest:
    changing it changes what restore resolves, so a build that ignored it could
    compile against different packages than the editor believes are in scope.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
