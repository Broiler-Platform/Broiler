{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broiler.dev/schemas/privacy-test-pages.schema.json",
  "title": "Broiler DuckDuckGo privacy test page corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "defaults",
    "pages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "expression": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baseUrl"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "The upstream repository the pages are authored in."
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Origin the pages are served from; every page path is resolved against it."
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutSeconds",
        "attempts",
        "startExpression",
        "resultsExpression"
      ],
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "startExpression": {
          "$ref": "#/$defs/expression",
          "description": "Evaluated first, to start a page that does not run its tests on load."
        },
        "resultsExpression": {
          "$ref": "#/$defs/expression",
          "description": "Evaluated last; must produce the page's results object as a JSON string."
        }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "startExpression": {
          "$ref": "#/$defs/expression"
        },
        "resultsExpression": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "Absolute path, including any query the page uses to run itself on load."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "startExpression": {
          "$ref": "#/$defs/expression"
        },
        "resultsExpression": {
          "$ref": "#/$defs/expression"
        }
      }
    }
  }
}
